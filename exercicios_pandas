# Exercício 58: Duração média de sessão 
# ---------------------------------------------------------------------
import pandas as pd
df = facebook_web_log.copy()
df = df[df['action'].isin(['page_load', 'page_exit'])]
df['timestamp'] = pd.to_datetime(df['timestamp'])
df['day'] = df['timestamp'].dt.date
load = df[df['action'] == 'page_load'].copy()
load = load.groupby(['user_id', 'day'])['timestamp'].max().reset_index(name='timestamp')
exit = df[df['action'] == 'page_exit'].copy()
exit = exit.groupby(['user_id', 'day'])['timestamp'].min().reset_index(name='timestamp')
res = load.merge(right=exit, on=['user_id', 'day'], how='inner')
res = res[res['timestamp_x'] < res['timestamp_y']]
res['soma'] = (res['timestamp_y'] - res['timestamp_x'])
res = res.groupby('user_id')['soma'].mean().reset_index(name='avg_session_duration')
 
 
