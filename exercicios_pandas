# Exercício 55: Inspeções por tipo e categoria de risco (pivotado)
# ---------------------------------------------------------------------
import pandas as pd
df = sf_restaurant_health_violations.copy()
risk_order = {
    'High Risk': 0,
    'Moderate Risk': 1,
    'Low Risk': 2
}
df['risk_rank'] = df['risk_category'].map(risk_order).fillna(3).astype(int)
idx_min = df.groupby('inspection_id')['risk_rank'].idxmin()
inspections = df.loc[idx_min, ['inspection_id', 'inspection_type', 'risk_category']].copy()
inspections['risk_category'] = inspections['risk_category'].fillna('No Risk Category')
counts = (
    inspections
    .groupby(['inspection_type', 'risk_category'])['inspection_id']
    .nunique()
    .reset_index(name='count')
)
pivot = counts.pivot(index='inspection_type', columns='risk_category', values='count').fillna(0)
for col in ['No Risk Category', 'Low Risk', 'Moderate Risk', 'High Risk']:
    if col not in pivot.columns:
        pivot[col] = 0
pivot = pivot[['No Risk Category', 'Low Risk', 'Moderate Risk', 'High Risk']].astype(int)
pivot['total'] = pivot.sum(axis=1)
pivot = pivot.sort_values(by='total', ascending=False).reset_index()
df_final = pivot
df_final
 
 
