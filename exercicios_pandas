# ---------------------------------------------------------------------
import pandas as pd
df = sf_events.copy()
df = df.drop_duplicates(subset=['user_id', 'record_date']).sort_values(by=['user_id', 'record_date'])
df['num'] = df.groupby('user_id').cumcount()
df['sum'] = df['record_date'] - pd.to_timedelta(df['num'], unit='D')
grupos = df.groupby(['user_id', 'sum']).size().reset_index(name='dias_consecutivos')
grupos = grupos[grupos['dias_consecutivos'] >= 3][['user_id']]
